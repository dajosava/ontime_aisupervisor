PORT=3001
HOST=0.0.0.0

# Chatwoot
CHATWOOT_DEFAULT_BASE_URL=https://app.ontime.chat
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_TOKEN=
AI_AGENT_SENDER_NAME=Super Admin
ARCHITECT_SENDER_NAMES=Manuel Limon,Kevin Landy,Israel Monge,Abigail Perez

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# 0 = sin límite de mensajes en el transcript histórico (se pagina todo Chatwoot)
MAX_AI_MESSAGES=0
MAX_TRANSCRIPT_CHARS=100000
MAX_CONVERSATION_MESSAGES=3000
CHATWOOT_MESSAGES_PAGE_SIZE=20

# Supabase
SUPABASE_URL=
# Service role: solo servidor (reportes, validar JWT). Nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=
# Anon key: login en el navegador (Authentication → Project Settings → API)
SUPABASE_ANON_KEY=
# false = desactiva login (solo desarrollo local)
AUTH_REQUIRED=true
SUPABASE_REPORTS_TABLE=conversation_supervision_reports
SUPABASE_SNAPSHOTS_TABLE=conversation_followup_snapshots
FOLLOWUP_TIMEZONE=America/Hermosillo
FOLLOWUP_STAGES=lead,asesor_venta
SUPERVISOR_PLAYBOOK_VERSION=v2
# Conversaciones con alguna de estas etiquetas Chatwoot no se analizan (CSV o config/supervisor-excluded-labels.json)
# SUPERVISOR_EXCLUDED_CHATWOOT_LABELS=anexob,contrato,pago,diseno,cliente,test

# Supervisor AI — ventana Chatwoot e inactividad
# Horas de actividad reciente a traer de Chatwoot (el resto del historial viene de Supabase)
CHATWOOT_ACTIVITY_WINDOW_HOURS=24
CHATWOOT_RECENT_MESSAGES_MAX_PAGES=30
# 0 = sin tope al listar conversaciones activas del inbox
SUPERVISOR_MAX_CONVERSATIONS=0
# Tope de páginas Chatwoot al listar (25 conv/página; 200 ≈ 5000 conversaciones)
SUPERVISOR_MAX_CONVERSATION_PAGES=200
# Días sin mensajes para etiqueta inactiva_interes_real
INACTIVE_DAYS_THRESHOLD=2

# Supervisor agente con herramientas — DEFECTO
# true = agente con tools (recomendado). false = legacy un solo prompt JSON.
SUPERVISOR_AGENT_MODE=true
# true = forzar legacy aunque AGENT_MODE esté activo
# SUPERVISOR_LEGACY_MODE=false
SUPERVISOR_AGENT_MAX_ROUNDS=10
SUPERVISOR_AGENT_MAX_TOOLS_PER_ROUND=5
# Si el agente no hace submit a tiempo, usa analyzeWithOpenAI con datos ya calculados
SUPERVISOR_AGENT_LEGACY_FALLBACK=true

# Configuración UI (pestaña Configuración del agente) — persiste en data/agent-settings.json
# SUPERVISOR_SETTINGS_PATH=./data/agent-settings.json
# SUPERVISOR_SETTINGS_BACKUPS_DIR=./data/backups
# SUPERVISOR_SETTINGS_MAX_BACKUPS=30
# Temperatura OpenAI (0–1; también en UI)
# SUPERVISOR_OPENAI_TEMPERATURE=0.1

# Análisis programado nocturno (node-cron dentro del servidor; también configurable en UI)
# SUPERVISOR_CRON_ENABLED=true
# SUPERVISOR_CRON_TIMEZONE=America/Hermosillo
# SUPERVISOR_CRON_SCHEDULES=51:22:00,49:22:30,48:23:00
# SUPERVISOR_CRON_SYNC_FOLLOWUP=true
# Secreto opcional para POST /api/supervisor/scheduler/run sin JWT (header x-scheduler-secret)
# SCHEDULER_SECRET=

# Logging supervisor (consola + opcional archivo en ./logs)
SUPERVISOR_LOG_LEVEL=info
SUPERVISOR_LOG_TO_FILE=false
SUPERVISOR_LOG_DIR=logs
SUPERVISOR_LOG_MAX_RUNS=30
SUPERVISOR_LLM_WARN_CHARS=80000
SUPERVISOR_LLM_ERROR_CHARS=120000

# Dominios de cotización (definidos en proxy-server.js QUOTE_URL_REGIONS; inbox 48=Nogales, 49/52=Hermosillo, 51=Obregón)
